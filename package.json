{
  "name": "sigflint",
  "version": "0.1.0",
  "description": "Fast, dependency-free AWS Signature Version 4 signing for every AWS service: headers, presigned URLs, SigV4a, chunked uploads and event streams. Node.js, Bun, Deno, Cloudflare Workers and browsers.",
  "keywords": [
    "aws",
    "s3",
    "sigv4",
    "sigv4a",
    "presigned-url",
    "signature",
    "signing",
    "authorization",
    "bun",
    "deno",
    "cloudflare-workers"
  ],
  "license": "MIT",
  "author": "Aaron Queen",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/node.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "workerd": "./src/web.js",
      "worker": "./src/web.js",
      "browser": "./src/web.js",
      "bun": "./dist/bun.js",
      "node": "./dist/node.js",
      "default": "./src/node.js"
    },
    "./web": {
      "types": "./types/web.d.ts",
      "default": "./src/web.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "types",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "esbuild src/node.js src/bun.js --bundle --format=esm --platform=node --target=es2022 --outdir=dist --log-level=warning",
    "pretest": "npm run build",
    "test": "node --test test/",
    "pretest:bun": "npm run build",
    "test:bun": "bun test test/",
    "types": "tsc && tsc -p test/types",
    "conformance": "node conformance/build.mjs && node conformance/build-more.mjs",
    "prepack": "tsc && npm run build",
    "check:package": "npm run build && publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "publint": "^0.3.25",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/sigflint.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/sigflint/issues"
  },
  "homepage": "https://github.com/OWNER/sigflint#readme"
}
