{
  "name": "sigflint",
  "version": "0.1.0",
  "description": "Fast, dependency-free AWS Signature Version 4 request signing for S3 on Node.js, Bun, Deno and Cloudflare Workers.",
  "keywords": [
    "aws",
    "s3",
    "sigv4",
    "signature",
    "signing",
    "authorization",
    "bun",
    "deno",
    "cloudflare-workers"
  ],
  "license": "MIT",
  "author": "Aaron Queen",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./src/node.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "workerd": "./src/web.js",
      "worker": "./src/web.js",
      "browser": "./src/web.js",
      "bun": "./src/bun.js",
      "default": "./src/node.js"
    },
    "./web": {
      "types": "./types/web.d.ts",
      "default": "./src/web.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/",
    "test:bun": "bun test test/",
    "types": "tsc && tsc -p test/types",
    "conformance": "node conformance/build.mjs",
    "prepack": "tsc",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.5",
    "publint": "^0.3.25",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/sigflint.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/sigflint/issues"
  },
  "homepage": "https://github.com/OWNER/sigflint#readme"
}
