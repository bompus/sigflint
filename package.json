{
  "name": "sigflint",
  "version": "1.0.1",
  "description": "Fast, dependency-free AWS Signature Version 4 signing for every AWS service: headers, presigned URLs, SigV4a, chunked uploads and event streams. Node.js, Bun, Deno, Cloudflare Workers and browsers.",
  "keywords": [
    "authorization",
    "aws",
    "bun",
    "cloudflare-workers",
    "deno",
    "presigned-url",
    "s3",
    "signature",
    "signing",
    "sigv4",
    "sigv4a"
  ],
  "homepage": "https://github.com/bompus/sigflint#readme",
  "bugs": {
    "url": "https://github.com/bompus/sigflint/issues"
  },
  "license": "MIT",
  "author": "bompus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bompus/sigflint.git"
  },
  "files": [
    "src",
    "dist",
    "types",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/node.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "workerd": "./src/web.js",
      "worker": "./src/web.js",
      "browser": "./src/web.js",
      "bun": "./dist/bun.js",
      "node": "./dist/node.js",
      "default": "./src/node.js"
    },
    "./web": {
      "types": "./types/web.d.ts",
      "default": "./src/web.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "esbuild src/node.js src/bun.js --bundle --format=esm --platform=node --target=es2022 --outdir=dist --log-level=warning",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.js\"",
    "pretest:bun": "npm run build",
    "test:bun": "bun test test/",
    "types": "tsc -p tsconfig.json && tsc -p tsconfig.build.json && tsc -p test/types",
    "types:streams": "tsc -p conformance/streams",
    "types:bench": "tsc -p bench",
    "conformance": "node conformance/build.mjs && node conformance/build-more.mjs",
    "prepack": "tsc -p tsconfig.build.json && npm run build",
    "lint": "tsc -p tsconfig.build.json && oxlint --deny-warnings",
    "format": "oxfmt . && ruff format . && git ls-files -z '*.sh' | xargs -0 shfmt -w",
    "check:style": "oxfmt --check . && npm run lint && npm run check:py && npm run check:sh",
    "check": "npm run check:style && npm run types && npm run types:streams && npm run types:bench && npm test && npm run check:package",
    "check:benchmarked": "node bench/check-benchmarked.mjs",
    "check:py": "ruff format --check . && ruff check .",
    "check:sh": "git ls-files -z '*.sh' | xargs -0 shellcheck && git ls-files -z '*.sh' | xargs -0 shfmt -d",
    "check:package": "tsc -p tsconfig.build.json && npm run build && publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "1.4.3",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "^0.3.25",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
