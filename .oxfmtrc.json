{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    "bun.lock",
    "**/*.md",
    "docs/**",
    "dist/**",
    "types/**",
    "test/corpus*.json",
    "package-lock.json",
    "**/package-lock.json",
    "bench/frozen/**",
    "bench/results/**",
    "conformance/*.json",
    "scripts/oxlint-plugin.mjs"
  ],
  "sortPackageJson": true,
  "singleQuote": true
}
